# Copy to .env and fill in. .env is gitignored.

# OpenAI — used by the default skills_eval_config.json.
OPENAI_API_KEY=

# OpenRouter (https://openrouter.ai/keys) — used for models under test + the judge.
OPENROUTER_API_KEY=

# Optional: Sarvam (https://dashboard.sarvam.ai) — only if you test Sarvam models.
SARVAM_API_KEY=
